# iStore: PACKAGE_TAR_XZ defaults to y, which makes luci-app-store's
# depends on !(PACKAGE_TAR_XZ) || PACKAGE_xz-utils evaluate false, so
# defconfig silently drops CONFIG_PACKAGE_luci-app-store=y. Keep tar's
# xz plugin off (sysupgrade uses gzip) to keep the iStore symbol visible.
# CONFIG_PACKAGE_TAR_XZ is not set
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR_CCA=y
