# ZWRT x86_64 build config (soft-router / PC)
# Derived from zwrt-re-ss-01.config: qualcommax/NSS/SoC-only packages and
# arm-only cpufreq removed; USB cellular, wifi (USB NICs), docker, iStore
# (+ TAR_XZ fix) and fullcone NAT kept. Critical-symbol list lives in
# .github/workflows/build-x86.yml.
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
# NSS WiFi offload is qualcommax-only (ath11k); keep kmod-qca-nss-drv
# out of x86 builds. kmod-ath11k is absent on x86, so
# ATH11K_NSS_SUPPORT is forced off via ath.mk depends as well.
CONFIG_ATH11K_NSS_SUPPORT=n
CONFIG_CCACHE=y
# Device package set exported from JDCloud RE-SS-01 (QWRT 25.12-nss)
CONFIG_PACKAGE_6rd=y
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_apk-openssl=y
CONFIG_PACKAGE_aria2=y
CONFIG_PACKAGE_aria2-openssl=y
CONFIG_PACKAGE_ariang=y
CONFIG_PACKAGE_attr=y
CONFIG_PACKAGE_autocore=y
